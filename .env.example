# Local API server
PORT=5000
NODE_ENV=development
# Comma-separated browser origins; add your LAN URL when testing from another device
CLIENT_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000

# MongoDB: use a dedicated empty HCM database for development/judging
MONGODB_URI=mongodb://127.0.0.1:27017/hcm-lite
MONGODB_DB_NAME=hcm-lite

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# AI provider (server-side only; keep the real key in .env)
AI_API_KEY=replace-with-your-provider-key
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash-lite

# Deployment variable split
# Render API: use build command `npm ci --include=dev && npm run build:server`,
# set PORT (or let Render provide it), NODE_ENV=production,
# CLIENT_ORIGIN=https://your-vercel-domain.vercel.app, all MongoDB/JWT/Gemini values,
# and do not set NEXT_PUBLIC_API_URL there.
# Vercel frontend: set only NEXT_PUBLIC_API_URL=https://your-api.onrender.com.
# Never upload .env to GitHub or paste secret values into the frontend project.
